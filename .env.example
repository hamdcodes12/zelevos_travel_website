PAYPAL_MODE=sandbox
# ─────────────────────────────────────────────────────────────────────────────
# Environment Configuration Template
# 
# Copy this file to .env and populate with real values for your environment.
# NEVER commit .env to version control. It is already in .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# Server Configuration
NODE_ENV=production
PORT=3000

# Security & Session Management
# REQUIRED in production. Generate strong random secrets for auth tokens.
SESSION_SECRET=your_secure_admin_session_secret_here_min_32_chars
USER_SESSION_SECRET=your_secure_user_session_secret_here_min_32_chars

# CORS Configuration
# Comma-separated list of allowed origins for API requests
CORS_ORIGINS=https://yourdomain.com,https://admin.yourdomain.com,https://partner.yourdomain.com

# PayPal Integration
# Get these from https://developer.paypal.com/dashboard
PAYPAL_CLIENT_ID=your_paypal_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_client_secret_here
PAYPAL_ENVIRONMENT=production

# Supabase Database & Auth
# Get these from https://app.supabase.com/project/[project-id]/settings/api
# 
# IMPORTANT: Use the SERVICE_ROLE key (secret), NOT the anon/publishable key!
# The service_role key starts with "eyJ" and has full database access.
# The anon key starts with "eyJ" but has limited Row Level Security permissions.
#
# Option 1 (Recommended): Use SUPABASE_SECRET_KEY
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SECRET_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...your_service_role_key_here
#
# Option 2 (Alternative): Use SUPABASE_SERVICE_ROLE_KEY
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...your_service_role_key_here
#
# Frontend/Public key (for client-side operations only, optional for backend):
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...your_anon_key_here
#
# Access token for Supabase Management API (optional):
SUPABASE_ACCESS_TOKEN=your_access_token_here

# Logging
LOG_LEVEL=info

# ─────────────────────────────────────────────────────────────────────────────
# Transactional Email Provider (Server-Side Only - Resend or SMTP)
# ─────────────────────────────────────────────────────────────────────────────
# Option 1: Resend REST API (Recommended)
# RESEND_API_KEY=re_your_api_key_here
# RESEND_FROM=Thinkatic <noreply@thinkatic.com>

# Option 2: Standard SMTP
# SMTP_HOST=smtp.mailgun.org
# SMTP_PORT=587
# SMTP_USER=postmaster@yourdomain.com
# SMTP_PASS=your_smtp_password
# SMTP_FROM=Thinkatic Global Operations <support@thinkatic.com>
# SMTP_SECURE=false

# Application Portal Base URL (for email portal action links)
# APP_BASE_URL=https://www.thinkatic.com

# ─────────────────────────────────────────────────────────────────────────────
# Phase 8: External CRM & Telephony Dialer Credentials (PLACEHOLDERS ONLY)
# Server-side environment variables for production OAuth & API integrations.
# Real credentials are NOT required in development. Unconfigured providers
# will safely display "Configuration Required".
# ─────────────────────────────────────────────────────────────────────────────
INTEGRATION_ENCRYPTION_KEY=your_32_byte_aes_256_gcm_hex_or_base64_encryption_key

# Salesforce Enterprise OAuth
SALESFORCE_CLIENT_ID=placeholder_salesforce_consumer_key
SALESFORCE_CLIENT_SECRET=placeholder_salesforce_consumer_secret
SALESFORCE_REDIRECT_URI=https://yourdomain.com/api/integrations/oauth/salesforce/callback

# HubSpot CRM OAuth
HUBSPOT_CLIENT_ID=placeholder_hubspot_app_client_id
HUBSPOT_CLIENT_SECRET=placeholder_hubspot_app_client_secret
HUBSPOT_REDIRECT_URI=https://yourdomain.com/api/integrations/oauth/hubspot/callback

# Zoho CRM OAuth
ZOHO_CLIENT_ID=placeholder_zoho_client_id
ZOHO_CLIENT_SECRET=placeholder_zoho_client_secret
ZOHO_REDIRECT_URI=https://yourdomain.com/api/integrations/oauth/zoho/callback

# Twilio Voice & Flex
TWILIO_ACCOUNT_SID=placeholder_twilio_account_sid
TWILIO_AUTH_TOKEN=placeholder_twilio_auth_token

# Genesys Cloud
GENESYS_CLIENT_ID=placeholder_genesys_client_id
GENESYS_CLIENT_SECRET=placeholder_genesys_client_secret
GENESYS_ENVIRONMENT=mypurecloud.com

# Vicidial & Custom Telephony Defaults
VICIDIAL_DEFAULT_HOST=https://telephony.thinkatic.internal

# ─────────────────────────────────────────────────────────────────────────────
# Supabase Production PostgreSQL Database & Storage Configuration
# ─────────────────────────────────────────────────────────────────────────────
# Direct PostgreSQL connection URL (optional if using Supabase REST/JS SDK):
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[project-ref].supabase.co:5432/postgres
DATABASE_URL=

