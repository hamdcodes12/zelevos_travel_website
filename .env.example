# ==============================================================================
# ZELEVOS PRODUCTION & DEVELOPMENT ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# How to generate 32-byte cryptographic hex secrets:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# DO NOT COMMIT REAL CREDENTIALS. Copy this file to .env and configure local values.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database & Persistence (PostgreSQL / Supabase / Embedded PGlite)
# ------------------------------------------------------------------------------
# For local dev/test: postgres://test:test@127.0.0.1:5432/test (triggers in-memory PGlite).
# For production: Full connection string to Supabase PostgreSQL with pooler.
DATABASE_URL=postgres://test:test@127.0.0.1:5432/test

# Supabase project URL (e.g. https://xyzcompany.supabase.co)
SUPABASE_URL=

# Supabase public anonymous key for client requests
SUPABASE_PUBLISHABLE_KEY=

# Supabase service role secret key for server-side elevated operations (keep private!)
SUPABASE_SECRET_KEY=

# Client-facing Supabase variables for Vite build
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# ------------------------------------------------------------------------------
# 2. Payment Gateway Integration (Razorpay)
# ------------------------------------------------------------------------------
# Set to 'test' for mock local gateway or 'razorpay' for live/test Razorpay API
PAYMENT_PROVIDER=test

# Razorpay Key ID (rzp_test_... for sandbox, rzp_live_... for production)
RAZORPAY_KEY_ID=

# Razorpay Key Secret (keep private!)
RAZORPAY_KEY_SECRET=

# Razorpay Webhook Secret for HMAC-SHA256 signature verification on /api/payments/webhook
RAZORPAY_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# 3. Session & Cryptographic Token Secrets (Must be at least 32 characters in production)
# ------------------------------------------------------------------------------
# Core user session signing key: generate with node crypto randomBytes(32).toString('hex')
SESSION_SECRET=

# Refresh token signing key: generate with node crypto randomBytes(32).toString('hex')
REFRESH_SECRET=

# Dedicated document token signing key (voucher/invoice/ticket/itinerary links): generate with crypto randomBytes(32)
DOCUMENT_SIGNING_SECRET=

# ------------------------------------------------------------------------------
# 4. Transactional Notifications & Email Service (Resend / SMTP)
# ------------------------------------------------------------------------------
# Resend API key for transactional emails (e.g. re_123456789)
RESEND_API_KEY=

# Verified sender address in Resend (e.g. "Zelevos <bookings@zelevos.travel>")
RESEND_FROM_EMAIL=Zelevos <onboarding@resend.dev>

# Recipient address for internal operational alerts and bookings
CLIENT_BOOKING_EMAIL=operations@zelevos.travel

# Email provider engine: 'test' for local/mock or 'resend' for live delivery
EMAIL_PROVIDER=test

# Fallback SMTP settings if using SMTP instead of Resend
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# ------------------------------------------------------------------------------
# 5. Application Server, Networking & Security
# ------------------------------------------------------------------------------
# Port for Express API server (default 8080 or 3000)
PORT=8080

# Environment mode: 'development', 'test', or 'production'
NODE_ENV=development

# Base URL for API endpoints
API_BASE_URL=http://localhost:8080

# Frontend URL for web application
FRONTEND_URL=http://localhost:8080

# Comma-separated list of allowed CORS origins
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Reverse proxy hops count for Express (e.g. 1 for Render.com proxy, false for local dev)
TRUST_PROXY=false

# Development OTP debugging: set to "true" ONLY in dev/test to return OTP in API responses. FORBIDDEN in production.
ALLOW_DEBUG_OTP=false

# Logging verbosity: 'fatal', 'error', 'warn', 'info', 'debug', 'trace'
LOG_LEVEL=info

# Default internal administrator ID and initial password for local setup
ADMIN_ID=
ADMIN_PASSWORD=

# ------------------------------------------------------------------------------
# 6. Social Authentication (Google & Facebook OAuth 2.0)
# ------------------------------------------------------------------------------
# Google OAuth Client ID
GOOGLE_CLIENT_ID=

# Google OAuth Client Secret
GOOGLE_CLIENT_SECRET=

# Facebook App ID
FACEBOOK_APP_ID=

# Facebook App Secret
FACEBOOK_APP_SECRET=

# ------------------------------------------------------------------------------
# 7. External Integrations (Maps & AI)
# ------------------------------------------------------------------------------
# Google Maps JavaScript API key for interactive travel maps
GOOGLE_MAPS_API_KEY=

# Google Gemini API key for itinerary assistants
GEMINI_API_KEY=

# Gemini model identifier (e.g. gemini-1.5-flash)
GEMINI_MODEL=gemini-1.5-flash
