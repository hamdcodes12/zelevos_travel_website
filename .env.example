# ==============================================================================
# WAYORA PRODUCTION & DEVELOPMENT ENVIRONMENT CONFIGURATION
# Supabase (required for production persistence and auth integration)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# ==============================================================================
# Copy this file to .env and configure real credentials for Live production mode,
# or leave unset to use the fully compliant offline test engine and mock payment.

# ------------------------------------------------------------------------------
# 1. Flight Provider Integration (Duffel GDS)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
# Set to 'duffel' for real live airline inventory and real PNR issuance.
# Set to 'test' for development and offline testing.
FLIGHT_PROVIDER=test

# Live Duffel Access Token (e.g. duffel_live_... or duffel_test_...)
FLIGHT_PROVIDER_API_KEY=
# Fallback alternative variable name supported by Duffel SDK
DUFFEL_ACCESS_TOKEN=

# ------------------------------------------------------------------------------
# 2. Payment Gateway Integration (Razorpay)
# ------------------------------------------------------------------------------
# Set to 'razorpay' for live checkout & server-side HMAC signature verification.
# Set to 'test' for simulated payment capture and instant verification.
PAYMENT_PROVIDER=razorpay

# Live or Test Razorpay Key ID (e.g. rzp_live_... or rzp_test_...)
RAZORPAY_KEY_ID=
# Razorpay Key Secret for server-side HMAC-SHA256 signature verification & refunds
RAZORPAY_KEY_SECRET=
# Razorpay Webhook Secret for verifying events at POST /api/payments/webhook
RAZORPAY_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# 3. Client Email & Transactional Service (Resend / SMTP)
# ------------------------------------------------------------------------------
# Target operations/client email that receives every confirmed flight booking notification
CLIENT_BOOKING_EMAIL=bookings@wayora.travel

# Resend API Key (Optional: when provided, Wayora dispatches transactional emails via Resend)
RESEND_API_KEY=

# Set to 'smtp' for live transactional email dispatch, or 'test' for mock dispatch
EMAIL_PROVIDER=test

# Gmail SMTP Configuration (used if RESEND_API_KEY is not configured)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
# Sending Gmail account (e.g. your-company@gmail.com)
SMTP_USER=
# 16-character Google App Password (NOT personal password) generated in Google Account -> Security
SMTP_PASS=

# ------------------------------------------------------------------------------
# 4. Application & Server Configuration
# ------------------------------------------------------------------------------
PORT=8080
NODE_ENV=development
API_BASE_URL=http://localhost:8080
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
SESSION_SECRET=
REFRESH_SECRET=

# Database Connection (Leave unset to use embedded PGlite for local development)
DATABASE_URL=

# ------------------------------------------------------------------------------
# 5. Social Authentication (Google & Facebook OAuth 2.0)
# ------------------------------------------------------------------------------
# Google OAuth 2.0 Client Credentials (from Google Cloud Console -> APIs & Services -> Credentials)
# Authorized redirect URI: ${API_BASE_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Facebook OAuth / Login App Credentials (from Meta for Developers -> App Dashboard)
# Authorized redirect URI: ${API_BASE_URL}/api/auth/facebook/callback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
