# ==============================================================================
# ZELEVOS PRODUCTION & DEVELOPMENT ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env and configure real credentials for live production mode,
# or leave unset to use the embedded PGlite test engine and test payments.

# ------------------------------------------------------------------------------
# 1. Database & Persistence (PostgreSQL / Supabase)
# ------------------------------------------------------------------------------
# Leave DATABASE_URL unset to use embedded PGlite for local development and tests.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# ------------------------------------------------------------------------------
# 2. Payment Gateway Integration (Razorpay)
# ------------------------------------------------------------------------------
# Set to 'razorpay' for live checkout & server-side HMAC signature verification.
# Set to 'test' for simulated payment capture and instant verification.
PAYMENT_PROVIDER=test
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# 3. Transactional Notifications (Email Service)
# ------------------------------------------------------------------------------
CLIENT_BOOKING_EMAIL=operations@zelevos.travel
RESEND_API_KEY=
EMAIL_PROVIDER=test
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=

# ------------------------------------------------------------------------------
# 4. Application & Server Configuration
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=development
API_BASE_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SESSION_SECRET=dev-secret-zelevos-session-key-minimum-32-chars
REFRESH_SECRET=dev-secret-zelevos-refresh-key-minimum-32-chars
LOG_LEVEL=info
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GOOGLE_MAPS_API_KEY=

# ------------------------------------------------------------------------------
# 5. Social Authentication (Google & Facebook OAuth 2.0)
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
